// Tarzan's Barbershop — booking schema
// Datetimes are ALWAYS stored as UTC ISO strings.
// Schedule (working hours) lives in src/lib/schedule.ts, not in DB.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums (SQLite has no native enums; use string + app-level validation)
// Status flow: PENDING (created by customer) -> CONFIRMED (manual by admin)
//                                            -> CANCELLED (no-show, late >20min, customer cancel)
//                                            -> COMPLETED (after the cut, increments loyaltyCount)

model Client {
  id            String    @id @default(cuid())
  name          String
  // Phone in E.164 format without "+" (e.g., 351912345678) — used for wa.me links and dedupe
  phone         String    @unique
  email         String?
  loyaltyCount  Int       @default(0) // increments on COMPLETED, every 6th = free
  // Set by the client in their account area
  preferredLocation String? // "lisboa" | "setubal"
  standingNote      String? // shown on every booking of theirs in the admin
  createdAt     DateTime  @default(now())
  bookings      Booking[]

  @@index([phone])
}

model Booking {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id])

  // Snapshot of customer email at booking time (Client.email may change later)
  email        String?

  serviceId    String    // matches id from src/lib/services.ts
  serviceName  String    // denormalized snapshot in case the service changes/is removed
  servicePrice Float     // denormalized in cents-equivalent (Float OK for 2dp money at this scale)
  durationMin  Int       // duration in minutes (snapshot)

  location     String    // "lisboa" | "setubal" — see src/lib/schedule.ts

  startUtc     DateTime  // ALWAYS UTC
  endUtc       DateTime  // ALWAYS UTC

  status       String    @default("PENDING") // PENDING | CONFIRMED | CANCELLED | COMPLETED

  // Tokens for email-action links. adminToken used in admin email confirm/reject buttons;
  // clientToken used in customer email "view your booking" link.
  adminToken   String    @unique @default(cuid())
  clientToken  String    @unique @default(cuid())

  confirmedAt    DateTime?
  cancelledAt    DateTime?
  reminderSentAt DateTime?

  // Google Calendar event id (set after successful GCal insert; null if pending or GCal write failed)
  gcalEventId  String?

  notes        String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([startUtc])
  @@index([location, startUtc])
  @@index([status])
}

// ---------- Admin security ----------

// One row per admin login. The cookie carries the id (HMAC-signed); revoking
// the row ends that session even though the cookie itself is still valid.
model AdminSession {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
}

// Every password/code attempt — used for rate limiting and the login log.
model LoginAttempt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  ip        String
  stage     String // "password" | "code"
  success   Boolean
  userAgent String?

  @@index([ip, createdAt])
  @@index([createdAt])
}

// One-time code emailed to the admin after the password (second factor).
model AdminLoginCode {
  id        String    @id @default(cuid())
  codeHash  String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
}

// "Lembrar este dispositivo": skips the emailed code until it expires.
model TrustedDevice {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
}

// ---------- Client accounts (passwordless: a code sent by email) ----------

model ClientLoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?

  @@index([email, createdAt])
}

// A signed-in client. clientId is null until they finish registering
// (name + phone) — until then the session only knows the email.
model ClientSession {
  id         String    @id @default(cuid())
  email      String
  clientId   String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([clientId])
}
